# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection
MONGO_URI_DEV=mongodb://localhost:27017/your-database-name
# Or use MongoDB Atlas connection string:
# MONGO_URI_DEV=mongodb+srv://username:password@cluster.mongodb.net/database-name

# Session Configuration
SESSION_SECRET=your-secret-key-change-this-in-production
SESSION_MAX_AGE=86400000

# Email Configuration (Required for email verification)
# For Gmail:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@sigmarecycling.com

# For Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication
# 3. Go to App Passwords: https://myaccount.google.com/apppasswords
# 4. Select "Mail" and your device
# 5. Copy the generated 16-character password
# 6. Use that password in EMAIL_PASS (no spaces)

# Alternative Email Services:
# 
# Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
#
# Yahoo:
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
#
# SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key
#
# Mailgun:
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587

# Admin Contact Email (for notifications)
ADMIN_CONTACT_EMAIL=admin@sigmarecycling.com

# Development Note:
# If email is not configured, verification codes will be printed to the console
# Check your terminal/server logs for the codes during development
